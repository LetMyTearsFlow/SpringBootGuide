<?xml version="1.0" encoding="UTF-8" ?>
<!DOCTYPE mapper
        PUBLIC "-//mybatis.org//DTD Mapper 3.0//EN"
        "https://mybatis.org/dtd/mybatis-3-mapper.dtd">

<mapper namespace="org.cqlin.mybatisbasicdemo.mapper.DemoMapper">

    <select id="findUserById" resultType="org.cqlin.mybatisbasicdemo.vo.User">
        SELECT id, name, age
        FROM user
        WHERE id = #{id}
    </select>

</mapper>